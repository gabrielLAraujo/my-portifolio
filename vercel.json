{
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://my-portifolio.vercel.app"
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.frauchesgabriel.work/$1",
      "permanent": true
    }
  ]
} 